type DeskState = {
  tickets: Ticket[];
  notes: Note[];
};

let memoryState: DeskState = {
  tickets: SEED_TICKETS,
  notes: SEED_NOTES,
};

function readLocal(): DeskState {
  try {
    const raw = localStorage.getItem(KEY);
    if (!raw) return memoryState;
    const parsed = JSON.parse(raw);
    if (Array.isArray(parsed.tickets) && Array.isArray(parsed.notes)) {
      memoryState = parsed;
      return parsed;
    }
  } catch {
    /* fallback to memory */
  }
  return memoryState;
}

function writeLocal(next: DeskState) {
  memoryState = next;
  try {
    localStorage.setItem(KEY, JSON.stringify(next));
  } catch {
    /* ignore */
  }
  window.dispatchEvent(new Event(EVENT));
}

function mapSupabaseRow(row: any): Ticket {
  return {
    id: String(row.id),
    pair: row.pair || "XAU/USD",
    side: row.side || "sell",
    setup: row.setup || "limit",
    open: Boolean(row.open),
    status: row.status || "New plan",
    vip: Boolean(row.vip),
    createdAt: row.created_at ? new Date(row.created_at).getTime() : Date.now(),
    closedAt: row.closed_at ? new Date(row.closed_at).getTime() : undefined,
    entry: row.entry || undefined,
    sl: row.sl || undefined,
    tp1: row.tp1 || undefined,
    tp2: row.tp2 || undefined,
    tp3: row.tp3 || undefined,
    pips: row.pips != null ? Number(row.pips) : undefined,
    result: row.result || undefined,
  };
}

export function useDesk() {
  const [supabaseTickets, setSupabaseTickets] = useState<Ticket[] | null>(null);

  useEffect(() => {
    const sb = getSupabase();
    if (!sb) return;

    let isMounted = true;

    async function loadTickets() {
      try {
        const { data, error } = await sb!
          .from("tickets")
          .select("*")
          .order("created_at", { ascending: false });

        if (!error && data && data.length > 0 && isMounted) {
          const mapped = data.map(mapSupabaseRow);
          setSupabaseTickets(mapped);
          const current = readLocal();
          writeLocal({ ...current, tickets: mapped });
        }
      } catch (err) {
        console.warn("Could not load tickets from Supabase:", err);
      }
    }

    loadTickets();

    // Dùng unique channel name để tránh lỗi collide khi React StrictMode remount
    const channelName = `tickets-feed-${Math.random().toString(36).slice(2, 9)}`;
    const channel = sb
      .channel(channelName)
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "tickets" },
        () => {
          loadTickets();
        }
      );

    channel.subscribe();

    return () => {
      isMounted = false;
      sb.removeChannel(channel);
    };
  }, []);

  const local = useSyncExternalStore(
    (onStoreChange) => {
      window.addEventListener(EVENT, onStoreChange);
      window.addEventListener("storage", onStoreChange);
      return () => {
        window.removeEventListener(EVENT, onStoreChange);
        window.removeEventListener("storage", onStoreChange);
      };
    },
    () => readLocal(),
    () => memoryState
  );

  return {
    tickets: supabaseTickets ?? local.tickets,
    notes: local.notes,
  };
}

export async function addTicket(ticket: Omit<Ticket, "id" | "pair" | "open" | "createdAt">) {
  const sb = getSupabase();
  const newTicket: Ticket = {
    ...ticket,
    id: `t_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,
    pair: "XAU/USD",
    open: true,
    createdAt: Date.now(),
  };

  const current = readLocal();
  const nextTickets = [newTicket, ...current.tickets];
  const newNote: Note = {
    id: `n_${Date.now()}`,
    title: `Lệnh mới: ${newTicket.side.toUpperCase()} ${newTicket.setup.toUpperCase()}`,
    body: newTicket.vip ? "Lệnh mới dành cho VIP." : "Lệnh FREE mới đã được công khai.",
    href: "/signals",
    createdAt: Date.now(),
    unread: true,
  };
  writeLocal({ tickets: nextTickets, notes: [newNote, ...current.notes] });

  if (sb) {
    try {
      await sb.from("tickets").insert({
        pair: newTicket.pair,
        side: newTicket.side,
        setup: newTicket.setup,
        status: newTicket.status,
        vip: newTicket.vip,
        entry: newTicket.entry,
        sl: newTicket.sl,
        tp1: newTicket.tp1,
        tp2: newTicket.tp2,
        tp3: newTicket.tp3,
        open: true,
      });
    } catch (e) {
      console.warn("Could not insert ticket to Supabase:", e);
    }
  }
}

export async function closeTicket(id: string, result: string, pips: number) {
  const current = readLocal();
  const nextTickets = current.tickets.map((t) => {
    if (t.id !== id) return t;
    return {
      ...t,
      open: false,
      status: result,
      result,
      pips,
      closedAt: Date.now(),
    };
  });
  writeLocal({ ...current, tickets: nextTickets });

  const sb = getSupabase();
  if (sb) {
    try {
      await sb
        .from("tickets")
        .update({
          open: false,
          status: result,
          result,
          pips,
          closed_at: new Date().toISOString(),
        })
        .eq("id", id);
    } catch (e) {
      console.warn("Could not close ticket on Supabase:", e);
    }
  }
}

export async function removeTicket(id: string) {
  const current = readLocal();
  const nextTickets = current.tickets.filter((t) => t.id !== id);
  writeLocal({ ...current, tickets: nextTickets });

  const sb = getSupabase();
  if (sb) {
    try {
      await sb.from("tickets").delete().eq("id", id);
    } catch (e) {
      console.warn("Could not delete ticket from Supabase:", e);
    }
  }
}

export function markNoteRead(id: string) {
  const current = readLocal();
  const nextNotes = current.notes.map((n) =>
    n.id === id ? { ...n, unread: false } : n
  );
  writeLocal({ ...current, notes: nextNotes });
}

export function markAllNotesRead() {
  const current = readLocal();
  const nextNotes = current.notes.map((n) => ({ ...n, unread: false }));
  writeLocal({ ...current, notes: nextNotes });
}

export function ticketTitle(t: Ticket) {
  return `${t.side.toUpperCase()} ${t.setup.toUpperCase()}`;
}

export function ageLabel(ts: number) {
  const diff = Math.max(0, Date.now() - ts);
  if (diff < h) {
    const mins = Math.max(1, Math.round(diff / m));
    return `${mins}m ago`;
  }
  if (diff < d) {
    const hours = Math.round(diff / h);
    return `${hours}h ago`;
  }
  const days = Math.round(diff / d);
  return `${days}d ago`;
}

export function pairLabel(_pair?: string) {
  return "GOLD";
}

export function pipsLabel(pips?: number) {
  if (pips == null) return "0 pips";
  return `${pips >= 0 ? "+" : ""}${pips} pips`;
}

export function winrate(tickets: Ticket[]) {
  const closed = tickets.filter((t) => !t.open);
  if (closed.length === 0) return 0;
  const wins = closed.filter((t) => (t.pips ?? 0) > 0).length;
  return Math.round((wins / closed.length) * 100);
}
