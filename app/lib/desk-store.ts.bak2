"use client";

import { useEffect, useState, useSyncExternalStore } from "react";
import { getSupabase } from "./supabase";

export type Ticket = {
  id: string;
  pair: string;
  side: "buy" | "sell";
  setup: "limit" | "market";
  open: boolean;
  status: string;
  vip: boolean;
  createdAt: number;
  closedAt?: number;
  entry?: string;
  sl?: string;
  tp1?: string;
  tp2?: string;
  tp3?: string;
  pips?: number;
  result?: string;
};

export type Note = {
  id: string;
  title: string;
  body: string;
  href: string;
  createdAt: number;
  unread: boolean;
};

